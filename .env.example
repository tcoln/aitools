# Example 配置文件
# 复制为 .env 并修改对应配置

# LLM 提供商选择
# 可选值: ollama | openai | chatabc | all
# - ollama:   仅使用本地 Ollama 模型
# - openai:   仅使用 OpenAI 兼容 API
# - chatabc:  仅使用 ChatABC 服务
# - all:      同时显示 Ollama + OpenAI + ChatABC 的模型列表
LLM_PROVIDER=ollama

# OpenAI 配置
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Ollama 配置
OLLAMA_API_BASE=http://localhost:11434

# ChatABC 配置
CHATABC_API_BASE=
CHATABC_API_KEY=
CHATABC_APP_ID=
CHATABC_TR_CODE=
CHATABC_TR_VERSION=1
CHATABC_MODEL=chatabc-agent

# JWT 密钥
SECRET_KEY=change-me-in-production