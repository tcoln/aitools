# ============================================================
#                        AI工具箱 配置文件
# ============================================================

# ==================== 基础配置 ====================
SECRET_KEY=your-secret-key-change-in-production
DEBUG=true

# ==================== LLM 提供商选择 ====================
# 可选值: ollama | openai | chatabc | all
# - ollama:   仅使用本地 Ollama 模型
# - openai:   仅使用 OpenAI 兼容 API
# - chatabc:  仅使用 ChatABC 服务
# - all:      同时显示 Ollama + OpenAI + ChatABC 的模型列表
LLM_PROVIDER=all

# ==================== OpenAI 配置 ====================
# 适用于 OpenAI 官方 API 或任何兼容 OpenAI 接口的服务
# （如: vLLM, LocalAI, DeepSeek, 通义千问 等）
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ==================== Ollama 配置 ====================
# 本地运行: http://localhost:11434
# 远程服务: http://<ip>:11434
OLLAMA_API_BASE=http://localhost:11434

# ==================== ChatABC 配置 ====================

# ChatABC 服务地址
CHATABC_API_BASE=http://aiml-pub.aisp.test.abc/agent-api/tool-agent-1-e70d3263
# 本地 Mock 调试地址（取消注释以使用）:
# CHATABC_API_BASE=http://localhost:9000

# ChatABC 认证密钥（如需要）
CHATABC_API_KEY=

# ChatABC 应用标识
CHATABC_APP_ID=

# ChatABC 事务代码
CHATABC_TR_CODE=

# ChatABC 事务版本
CHATABC_TR_VERSION=1

# 在模型列表中显示的名称
CHATABC_MODEL=chatabc-agent